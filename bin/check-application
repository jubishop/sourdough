#!/usr/bin/env python3
"""Run sourdough's application checks; bin/check --full calls this after the foundation checks."""

from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def main():
    if not (ROOT / "package.json").exists():
        return 0
    result = 0
    try:
        for command in (["pnpm", "typecheck"], ["pnpm", "lint"], ["pnpm", "build"]):
            result = subprocess.run(command, cwd=ROOT).returncode
            if result:
                break
    except FileNotFoundError:
        print("pnpm is required. Run bin/setup before bin/check.", file=sys.stderr)
        result = 1
    return result


if __name__ == "__main__":
    sys.exit(main())
