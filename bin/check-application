#!/usr/bin/env python3
"""Run sourdough's application checks; bin/check --full calls this after the foundation checks."""

from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def main():
    result = subprocess.run([sys.executable, "-B", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-v"],
                            cwd=ROOT).returncode
    if result or not (ROOT / "package.json").exists():
        return result
    try:
        for command in (["pnpm", "typecheck"], ["pnpm", "lint"], ["pnpm", "build"]):
            result = subprocess.run(command, cwd=ROOT).returncode
            if result:
                break
    except FileNotFoundError:
        print("pnpm is required. Run bin/setup-application before bin/check.", file=sys.stderr)
        result = 1
    return result


if __name__ == "__main__":
    sys.exit(main())
