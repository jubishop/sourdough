#!/usr/bin/env python3
"""Print the create_deployment requestBody for a pushed revision of the site.

Usage: bin/vercel-request [REVISION]

REVISION defaults to origin/main and must already be on origin/main. Files are
listed by SHA-1 and size: the tracked files at REVISION minus those matching
its .vercelignore and the .gitignore file itself, which the Vercel CLI never
uploads either. projectSettings come from its vercel.json.
"""

import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
from _vercel import PROJECT_ID, git, pushed_commit


def files(revision):
    with tempfile.TemporaryDirectory() as temporary:
        env = {**os.environ, "GIT_INDEX_FILE": str(Path(temporary, "index"))}
        ignore = Path(temporary, "vercelignore")
        ignore.write_bytes(git("show", f"{revision}:.vercelignore"))
        git("read-tree", revision, env=env)
        ignored = set(git("ls-files", "-z", "-ci", f"--exclude-from={ignore}", env=env).split(b"\0"))
        entries = [entry for entry in git("ls-files", "-z", "-s", env=env).split(b"\0") if entry]
    listed = []
    for entry in entries:
        fields, path = entry.split(b"\t", 1)
        if path in ignored or path == b".gitignore":
            continue
        data = git("cat-file", "blob", fields.split()[1].decode())
        listed.append({"file": path.decode(), "sha": hashlib.sha1(data).hexdigest(), "size": len(data)})
    return listed


def main():
    if len(sys.argv) > 2 or sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    revision = sys.argv[1] if len(sys.argv) == 2 else "origin/main"
    try:
        commit = pushed_commit(revision)
        settings = json.loads(git("show", f"{commit}:vercel.json"))
        body = {
            "name": "sourdough",
            "project": PROJECT_ID,
            "target": "production",
            "files": files(commit),
            "projectSettings": {key: settings[key] for key in ("framework", "buildCommand", "installCommand")},
            "gitMetadata": {
                "commitSha": commit,
                "commitRef": "main",
                "commitMessage": git("log", "-1", "--format=%s", commit).decode().strip(),
                "remoteUrl": git("remote", "get-url", "origin").decode().strip(),
                "dirty": False,
            },
        }
    except subprocess.CalledProcessError as error:
        print(error.stderr.decode().strip() or error, file=sys.stderr)
        return 1
    except (RuntimeError, KeyError, ValueError) as error:
        print(error, file=sys.stderr)
        return 1
    print(json.dumps(body, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
