#!/usr/bin/env python3
from pathlib import Path
import subprocess
import sys
sys.dont_write_bytecode = True
from _knowledge import cli

result = cli("setup")
root = Path(__file__).resolve().parents[1]
if result == 0 and (root / "package.json").exists():
    try:
        result = subprocess.run(["pnpm", "install", "--frozen-lockfile"], cwd=root).returncode
    except FileNotFoundError:
        print("pnpm is required. Install the version in package.json, then rerun bin/setup.", file=sys.stderr)
        result = 1
sys.exit(result)
