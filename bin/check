#!/usr/bin/env python3
from pathlib import Path
import subprocess
import sys
sys.dont_write_bytecode = True
from _checks import main

result = main()
root = Path(__file__).resolve().parents[1]
if result == 0 and sys.argv[1:] != ["--documents-only"] and (root / "package.json").exists():
    try:
        commands = [["pnpm", "typecheck"], ["pnpm", "lint"]]
        if sys.argv[1:] == ["--full"]:
            commands.append(["pnpm", "build"])
        for command in commands:
            result = subprocess.run(command, cwd=root).returncode
            if result:
                break
    except FileNotFoundError:
        print("pnpm is required. Run bin/setup before bin/check.", file=sys.stderr)
        result = 1
sys.exit(result)
